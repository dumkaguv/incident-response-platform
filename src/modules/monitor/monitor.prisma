// use prisma-next

enum MonitorMethod {
  GET
  HEAD
  POST
}

enum MonitorStatus {
  UP
  DOWN
}

enum CheckErrorType {
  TIMEOUT
  DNS_ERROR
  CONNECTION_REFUSED
  TLS_ERROR
  INVALID_STATUS_CODE
  ASSERTION_FAILED
  UNKNOWN
}

model Monitor {
  id                 String             @id @default(uuid())
  name               String
  url                String
  method             MonitorMethod      @default(GET)
  intervalSeconds    Int                @default(60)   @map("interval_seconds")
  timeoutMs          Int                @default(5000) @map("timeout_ms")
  expectedStatusCode Int                @default(200)  @map("expected_status_code")
  isActive           Boolean            @default(true) @map("is_active")
  nextCheckAt        TimestamptzString?                @map("next_check_at")
  createdAt          TimestamptzString  @default(now()) @map("created_at")
  updatedAt          temporal.updatedAtString()        @map("updated_at")

  checks MonitorCheck[]

  @@index([createdAt, id])
  @@index([isActive, name])
}

model MonitorCheck {
  id             String            @id @default(uuid())
  monitorId      String            @map("monitor_id")
  status         MonitorStatus
  statusCode     Int?              @map("status_code")
  responseTimeMs Int?              @map("response_time_ms")
  errorType      CheckErrorType?   @map("error_type")
  checkedAt      TimestamptzString @default(now()) @map("checked_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([checkedAt, id])
  @@index([monitorId, checkedAt, id])
}
