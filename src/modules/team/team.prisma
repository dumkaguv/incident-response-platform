// use prisma-next

enum TeamRole {
  LEAD
  RESPONDER
  OBSERVER
}

model Team {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString()        @map("updated_at")

  incidents Incident[]
  members   TeamMember[]

  @@index([name])
  @@map("team")
}

model TeamMember {
  id        String            @id @default(uuid())
  teamId    String            @map("team_id")
  name      String
  email     String            @unique
  role      TeamRole          @default(RESPONDER)
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString()        @map("updated_at")

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId, name])
  @@map("team_member")
}
