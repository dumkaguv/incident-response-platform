{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [
    "\\.d\\.ts$"
  ],
  "module": {
    "type": "nodenext",
    "resolveFully": true
  },
  "jsc": {
    "target": "es2023",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "keepClassNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "experimental": {
      "keepImportAttributes": true,
      "plugins": [
        [
          "@lingui/swc-plugin",
          {}
        ]
      ]
    }
  },
  "sourceMaps": false,
  "minify": false
}
