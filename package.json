{
  "name": "incident-response-platform",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "node --import ./tools/swc/register.mjs src/main.ts",
    "dev": "node --watch --import ./tools/swc/register.mjs src/main.ts",
    "build": "pnpm typecheck && swc src -d dist --delete-dir-on-start --copy-files --strip-leading-paths",
    "debug": "node --inspect --watch --import ./tools/swc/register.mjs src/main.ts",
    "prod": "node dist/main.js",
    "format": "oxfmt --write src test prisma prisma.config.ts tools lingui.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src test prisma prisma.config.ts tools lingui.config.ts vitest.config.ts",
    "lint": "oxlint --fix --max-warnings 0 src test prisma prisma.config.ts tools lingui.config.ts vitest.config.ts",
    "lint:check": "oxlint --max-warnings 0 src test prisma prisma.config.ts tools lingui.config.ts vitest.config.ts",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:ts5": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "test:query:integration": "node node_modules/prisma7/build/index.js generate --config test/query-core/fixtures/prisma.config.ts && vitest run --project integration",
    "docs:api": "spectaql spectaql-config.yml",
    "docs:api:dev": "spectaql --develop --port 4400 spectaql-config.yml",
    "i18n:extract": "node node_modules/@lingui/cli/dist/lingui.js extract --clean --overwrite",
    "i18n:compile": "node node_modules/@lingui/cli/dist/lingui.js compile --typescript",
    "i18n:verify": "pnpm i18n:extract && pnpm i18n:compile && git diff --exit-code -- src/i18n/catalogs src/i18n/generated",
    "postinstall": "pnpm prisma:emit",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commitlint": "node node_modules/@commitlint/cli/cli.js",
    "test:all": "vitest run",
    "prisma:contract": "node --import ./tools/swc/register.mjs tools/prisma/build-contract.ts",
    "prisma:emit": "pnpm prisma:contract && prisma contract emit",
    "prisma:db-init": "prisma db init",
    "prisma:db-update": "prisma db update",
    "prisma:db-verify": "prisma db verify",
    "prisma:migrate-plan": "prisma migration plan",
    "prisma:migrate": "prisma db migrate",
    "prisma:search-indexes": "node --import ./tools/swc/register.mjs prisma/search-indexes/index.ts",
    "prisma:migrate-status": "prisma migration status",
    "prisma:seed": "node --import ./tools/swc/register.mjs prisma/seed/index.ts"
  },
  "lint-staged": {
    "{src,test,prisma}/**/*.{ts,js,json}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@lingui/core": "6.6.0",
    "@lingui/message-utils": "6.6.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "express": "^5.2.1",
    "graphql": "^16.11.0",
    "graphql-query-complexity": "^2.0.0",
    "helmet": "^8.3.0",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lingui/cli": "6.6.0",
    "@lingui/conf": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@lingui/swc-plugin": "6.7.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/cli-engine": "0.3.0",
    "@prisma/client": "^7.10.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-regexp": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "^8.23.0",
    "prisma": "8.0.0-rc.13",
    "prisma7": "npm:prisma@^7.10.0",
    "source-map-support": "^0.5.21",
    "spectaql": "^3.0.9",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript7": "npm:typescript@^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
