        "sql": "CREATE TABLE \"public\".\"incident\" (\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"description\" text,\n  \"id\" text NOT NULL,\n  \"resolved_at\" timestamptz,\n  \"severity\" text NOT NULL,\n  \"status\" text DEFAULT 'OPEN' NOT NULL,\n  \"team_id\" text,\n  \"title\" text NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"incident_severity_check_5e5a5e80\" CHECK (\"severity\" IN ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')),\n  CONSTRAINT \"incident_status_check_c5e65004\" CHECK (\"status\" IN ('OPEN', 'INVESTIGATING', 'RESOLVED', 'CLOSED'))\n)",
